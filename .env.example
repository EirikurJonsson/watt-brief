# ENTSO-E Transparency Platform token
ENTSOE_API_TOKEN=

# Any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=

# Model per step, set after comparing them in the evals
MODEL_PLANNER=
MODEL_ANALYST=
MODEL_CRITIC=

# --- Service (all optional, shown with defaults) ---
# "fixture" serves synthetic data and labels every response as such
# FACTS_SOURCE=fixture
# DAILY_SPEND_CAP_USD=1.0
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=100
# MAX_CONCURRENT_REQUESTS=4
# KILL_SWITCH_FILE=KILL_SWITCH
# Only behind Cloudflare Tunnel with no open ports (the header is spoofable otherwise)
# TRUST_CF_CONNECTING_IP=false
# /metrics is disabled unless this is set
# METRICS_TOKEN=
# ALERT_WEBHOOK_URL=
